+ compose up -d --build (all services)
+ compose exec recorder bash -lc mkdir -p /run/agentwatch; (agentwatch-daemon >/tmp/daemon.log 2>&1 &) ; \
       for i in $(seq 1 50); do [ -S "$AGENTWATCH_SOCKET" ] && exit 0; sleep 0.2; done; \
       echo "daemon socket did not appear" >&2; tail -20 /tmp/daemon.log >&2; exit 1
+ compose exec recorder bash -lc mkdir -p /data/agentwatch; pgrep -f "[a]gentwatch-daemon" | head -1 > /data/agentwatch/daemon.pid
+ compose exec recorder bash -lc python3 /ft/scripts/run-soak.py --count 10000 --interval 0.01 --min-delivery 0.99
+ compose exec recorder bash -lc agentwatch verify-store
