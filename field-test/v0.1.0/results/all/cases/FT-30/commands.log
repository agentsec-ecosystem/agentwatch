+ compose up -d --build (all services)
+ compose exec recorder bash -lc agentwatch --set store.path=/data/agentwatch migrate 2>&1 | grep -q E_NOT_IMPLEMENTED
+ compose exec recorder bash -lc ! agentwatch --set store.path=/data/agentwatch migrate
+ compose exec recorder bash -lc agentwatch --set store.path=/data/agentwatch verify-store
