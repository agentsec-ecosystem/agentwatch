{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentsec-ecosystem/agentwatch/schema/agent-record.schema.json",
  "title": "agentwatch record",
  "description": "A normalized agent activity record (tool call / behavior span).",
  "type": "object",
  "required": ["schema_version", "session_id", "agent", "tool", "outcome", "started_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "session_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "span_id": { "type": "string" },
    "parent_span_id": { "type": ["string", "null"] },
    "harness": { "type": "string", "examples": ["claude-code", "cursor", "langgraph", "python"] },
    "agent": {
      "type": "object",
      "required": ["identity"],
      "properties": {
        "identity": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "prompt_version": { "type": "string" },
        "model_version": { "type": "string" },
        "tool_schema_version": { "type": "string" },
        "workload_type": { "type": "string" }
      }
    },
    "tool": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "server": { "type": ["string", "null"], "description": "MCP server, if any" },
        "arguments": { "type": ["object", "null"], "description": "Redacted per privacy mode" },
        "privacy_mode": { "enum": ["metadata-only", "truncated", "hashed", "full"] }
      }
    },
    "outcome": { "enum": ["ok", "error", "denied"] },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": ["string", "null"], "format": "date-time" },
    "duration_ms": { "type": ["number", "null"] },
    "tokens": { "type": ["integer", "null"] },
    "cost_usd": { "type": ["number", "null"] },
    "step_type": { "enum": ["reason", "act", "observe", "verify", null] },
    "security_event": { "$ref": "security-event.schema.json" }
  },
  "additionalProperties": false
}
