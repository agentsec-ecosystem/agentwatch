{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentwatch.dev/schema/cli/v0.1.0/secrets.schema.json",
  "title": "agentwatch secrets --json",
  "description": "Array of secret traces from `agentwatch secrets --json`.",
  "x-agentwatch-command": "secrets",
  "x-agentwatch-cli-version": "v0.1.0",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string"
      },
      "fingerprint": {
        "type": "string"
      },
      "first_index": {
        "type": "integer"
      },
      "sightings": {
        "type": "integer"
      },
      "sinks": {
        "type": "array"
      },
      "verdict": {
        "type": "string"
      }
    }
  }
}
