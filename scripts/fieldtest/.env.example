# Field-test environment. Copy to `.env` and edit.
# Results are written to field-test/v0.1.0/results/<UTC-ts>/ (see FIELD_TEST_PLAN.md).

# --- recorder under test -----------------------------------------------------
FT_PRIVACY_MODE=truncated   # metadata-only | truncated | hashed | full

# --- local LLM (OMLX), OpenAI-compatible -------------------------------------
# OMLX listens on the host at port 8000 (Docker Desktop reaches it via
# host.docker.internal). The compose `api` service publishes host 8100 -> 
# container 8000, so host:8000 is free for OMLX and there is no collision.
OMLX_BASE_URL=http://host.docker.internal:8000/v1
OMLX_MODEL=Qwen3-4B-Instruct-2507-4bit
OMLX_API_KEY=

# --- image pins --------------------------------------------------------------
FT_TAG=local
POSTGRES_TAG=16
JAEGER_TAG=1.57
OTELCOL_TAG=0.107.0

# --- stack behavior ----------------------------------------------------------
STACK_TIMEOUT=180
STACK_KEEP=0
